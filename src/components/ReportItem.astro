---
import type { ReportItem } from "../domain/report";
import { composeItemBody, withoutPopularityFiller } from "../presentation/clean-copy";

interface Props {
  item: ReportItem;
  compact?: boolean;
  previousHref?: string | undefined;
}

const { item, compact = false, previousHref } = Astro.props;

const keySources = item.sources.filter((source) => source.key);
const titleSource = keySources[0] ?? item.sources[0];
const displayTitle = withoutPopularityFiller(item.title);
const displayBody = composeItemBody(item.summary, item.analysis);
---

<article class:list={["report-item", { compact, "has-image": item.imageUrl }]} data-report-card data-section={item.section} data-topics={item.topics.join(",")} data-search={`${displayTitle} ${displayBody}`}>
  <header class="item-heading">
    <h3 id={item.id}>
      {
        titleSource
          ? <a class="title-link" href={titleSource.url} rel="noreferrer">{displayTitle}</a>
          : displayTitle
      }
    </h3>
    {previousHref && <a class="story-link" href={previousHref}>← 查看此前脉络</a>}
  </header>

  <div class="item-content">
    {item.imageUrl && item.imageAlt && (
      <figure class="product-shot">
        <img
          src={item.imageUrl}
          alt={item.imageAlt}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </figure>
    )}
    {displayBody && <p class="summary">{displayBody}</p>}
  </div>
</article>
