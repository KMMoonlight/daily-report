---
import { getCollection } from "astro:content";
import ReportItem from "../components/ReportItem.astro";
import { dailyEdition } from "../domain/report";
import BaseLayout from "../layouts/BaseLayout.astro";

const reports = (await getCollection("daily")).sort((a, b) => b.data.date.localeCompare(a.data.date));
const entries = reports.flatMap((report) =>
  report.data.items.map((item) => ({
    reportId: report.id,
    reportDate: dailyEdition(report.data.coverageEnd).date,
    item,
  })),
);
const sections = [
  { id: "products", title: "新品与工具" },
  { id: "research", title: "研究与开源" },
  { id: "deep-reads", title: "深度阅读" },
  { id: "events", title: "行业消息" },
  { id: "radar", title: "简讯" },
]
  .map((section) => ({ ...section, entries: entries.filter(({ item }) => item.section === section.id) }))
  .filter((section) => section.entries.length > 0);

const pageSize = 12;
---

<BaseLayout title="归档 · Tech Daily & Weekly">
  <section class="archive-shell">
    <form class="filters" id="search" onsubmit="return false">
      <label>
        栏目
        <select name="section" aria-label="栏目">
          <option value="">全部栏目</option>
          <option value="products">新品与工具</option>
          <option value="research">研究与开源</option>
          <option value="deep-reads">深度阅读</option>
          <option value="events">行业消息</option>
          <option value="radar">简讯</option>
        </select>
      </label>
      <label>
        核心主题
        <select name="topic" aria-label="核心主题">
          <option value="">全部主题</option>
          <option value="ai">AI / 智能体</option>
          <option value="developer-tools">开发者工具</option>
          <option value="chips">芯片 / 算力</option>
          <option value="robotics">机器人</option>
          <option value="consumer-tech">消费科技</option>
          <option value="tech-radar">科技雷达</option>
        </select>
      </label>
      <label>
        搜索
        <input name="query" type="search" aria-label="搜索" placeholder="标题、摘要或分析…" autocomplete="off" />
      </label>
    </form>

    <div class="report-sections" data-archive-list data-page-size={pageSize}>
      {
        sections.map((section, index) => (
          <section class="report-section" data-archive-section={section.id}>
            <header class="section-heading">
              <span class="section-number">{String(index + 1).padStart(2, "0")}</span>
              <div><h2>{section.title}</h2></div>
            </header>
            <div class="section-items">
              {section.entries.map(({ reportId, reportDate, item }) => (
                <div data-entry>
                  <a class="report-date archive-date" href={`/daily/${reportId}#${item.id}`}>{reportDate}</a>
                  <ReportItem item={item} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <p class="empty-state" data-empty>没有符合条件的内容。</p>
    <button type="button" class="load-more" data-load-more hidden>加载更多</button>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(".filters");
  const list = document.querySelector<HTMLElement>("[data-archive-list]");
  const entries = [...document.querySelectorAll<HTMLElement>("[data-entry]")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-archive-section]")];
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const loadMore = document.querySelector<HTMLButtonElement>("[data-load-more]");
  const pageSizeAttr = () => Math.max(1, Number(list?.dataset.pageSize ?? 12) || 12);
  let shownCount = pageSizeAttr();

  function matchedEntries() {
    if (!form) return [];
    const data = new FormData(form);
    const section = String(data.get("section") ?? "");
    const topic = String(data.get("topic") ?? "");
    const query = String(data.get("query") ?? "").trim().toLocaleLowerCase("zh-CN");

    return entries.filter((entry) => {
      const card = entry.querySelector<HTMLElement>("[data-report-card]");
      return Boolean(
        card &&
          (!section || card.dataset.section === section) &&
          (!topic || card.dataset.topics?.split(",").includes(topic)) &&
          (!query || card.dataset.search?.toLocaleLowerCase("zh-CN").includes(query)),
      );
    });
  }

  function refreshView() {
    const matched = matchedEntries();
    const visibleSet = new Set(matched.slice(0, shownCount));

    for (const entry of entries) {
      entry.hidden = !visibleSet.has(entry);
    }
    for (const sectionGroup of sections) {
      sectionGroup.hidden = ![...sectionGroup.querySelectorAll<HTMLElement>("[data-entry]")].some(
        (entry) => !entry.hidden,
      );
    }

    if (empty) empty.style.display = matched.length ? "none" : "block";
    if (loadMore) loadMore.hidden = matched.length <= shownCount;
  }

  function resetAndRefresh() {
    shownCount = pageSizeAttr();
    refreshView();
  }

  form?.addEventListener("input", resetAndRefresh);
  form?.addEventListener("change", resetAndRefresh);
  loadMore?.addEventListener("click", () => {
    shownCount += pageSizeAttr();
    refreshView();
  });

  refreshView();
</script>
