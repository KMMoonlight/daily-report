---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const recentDailyReports = (await getCollection("daily"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 7);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Daily signal · Weekly context</p>
    <h1>今天，科技世界改变了什么？</h1>
    {
      recentDailyReports.length > 0 ? (
        <nav class="recent-editions" aria-label="最近日报">
          <ul>
            {recentDailyReports.map((report, index) => (
              <li>
                <a href={`/daily/${report.id}`}>
                  <span class="report-date">{report.data.date}</span>
                  <strong>{index === 0 ? "最新日报" : report.data.title}</strong>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <p class="hero-empty">暂无日报。</p>
      )
    }
  </section>
</BaseLayout>
