---
import { getCollection } from "astro:content";
import ReportSections from "../../components/ReportSections.astro";
import { dailyEdition } from "../../domain/report";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const reports = await getCollection("daily");
  return reports.map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const edition = dailyEdition(report.data.coverageEnd);
const allDailyReports = await getCollection("daily");
const itemLocations = new Map<string, string>();
for (const dailyReport of allDailyReports) {
  for (const item of dailyReport.data.items) {
    itemLocations.set(item.id, `/daily/${dailyReport.id}#${item.id}`);
  }
}
---

<BaseLayout title={`${edition.title} · Tech Daily & Weekly`}>
  <article class="report-shell">
    <header class="page-heading">
      <div>
        <p class="report-date">{edition.date} · Daily</p>
        <h1>{edition.title}</h1>
      </div>
      <a href="/archive">返回归档</a>
    </header>
    <ReportSections items={report.data.items} itemLocations={itemLocations} />
  </article>
</BaseLayout>
