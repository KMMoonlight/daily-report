---
import { getCollection, render } from "astro:content";
import ReportItem from "../../components/ReportItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const reports = await getCollection("daily");
  return reports.map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const allDailyReports = await getCollection("daily");
const correctionsByOriginal = new Map<string, Array<{ href: string; title: string }>>();
const itemLocations = new Map<string, string>();
for (const dailyReport of allDailyReports) {
  for (const item of dailyReport.data.items) {
    itemLocations.set(item.id, `/daily/${dailyReport.id}#${item.id}`);
    if (!item.correctsItemId) continue;
    const corrections = correctionsByOriginal.get(item.correctsItemId) ?? [];
    corrections.push({ href: `/daily/${dailyReport.id}#${item.id}`, title: item.title });
    correctionsByOriginal.set(item.correctsItemId, corrections);
  }
}
---

<BaseLayout title={`${report.data.title} · Tech Daily & Weekly`}>
  <article class="report-shell">
    <header class="page-heading">
      <div>
        <p class="report-date">{report.data.date} · Daily</p>
        <h1>{report.data.title}</h1>
      </div>
      <a href="/archive">返回归档</a>
    </header>
    <div class="report-intro"><Content /></div>
    <div class="item-grid">
      {
        report.data.items.map((item) => (
          <ReportItem
            item={item}
            corrections={correctionsByOriginal.get(item.id) ?? []}
            previousHref={item.previousItemId ? itemLocations.get(item.previousItemId) : undefined}
          />
        ))
      }
    </div>
  </article>
</BaseLayout>
