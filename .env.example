APP_PORT=8080

# openai-compatible | anthropic | gemini
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TRIAGE_MODEL=
LLM_SYNTHESIS_MODEL=
AUTO_PUBLISH=false
# Beijing hour when automatic daily generation may start (default 9)
SCHEDULER_MIN_HOUR=9

# Optional. Add only after anonymous GitHub limits become a bottleneck.
GITHUB_TOKEN=
